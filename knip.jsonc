// `pnpm check:unused`: fails on an unused file, dependency, export or type.
//
// @limitation Nothing under convex/ is checked: every file there is an entry point, because the
// generated `api` object reaches them by path. C19 covers router exports; `functions/` is uncovered.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // Read by the tool that owns them, never imported.
    "fingerprint.config.js",
    // Run by hand, so no package.json script names them.
    "scripts/*.mjs",
    "scripts/images/*.ts",
    "scripts/videos/*.ts",
    // The Android and web half of a platform pair: knip resolves the import to `index.ios.tsx`.
    "src/ui/components/more-button/index.tsx",
    // Run by .githooks/pre-commit and .githooks/pre-push, which knip does not read.
    "scripts/memory/pre-commit.mjs",
    "scripts/memory/pre-push.mjs",
    // Run by Claude Code from .claude/settings.json; an entry so knip sees what it imports.
    ".claude/hooks/session-start-memory.mjs",
    // Agent memory modules built before their callers. Each line goes when memory:update (or,
    // for pii.mjs, condense.mjs, which is the first caller of `mask`; C20 only uses `scan`)
    // imports it (docs/plans/agent-memory.md, slice 7).
    "scripts/memory/_lib/stamps.mjs",
    "scripts/memory/_lib/pii.mjs",
    "scripts/memory/_lib/usage.mjs",
    "scripts/memory/_lib/memoryIndex.mjs"
  ],
  // Run by Claude Code from .claude/settings.json.
  "ignoreFiles": [".claude/hooks/**"],
  "ignoreDependencies": [
    // Run by .githooks/commit-msg as a binary.
    "@commitlint/cli",
    // Optional peers of expo-router, which the lockfile resolves against these copies.
    "@react-native-masked-view/masked-view",
    "@testing-library/user-event",
    "expo-glass-effect",
    // Nothing imports it, and removing it needs a new native build: an open decision.
    "expo-apple-authentication"
  ]
}
