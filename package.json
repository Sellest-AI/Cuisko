    "@posthog/convex": "2.1.5",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/flash-list": "2.0.2",
    "ai": "^7.0.77",
    "blobatar": "^2.7.0",
    "cheerio": "^1.2.0",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.121",
    "expo": "~57.0.26",
