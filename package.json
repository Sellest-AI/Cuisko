{
  "name": "cuisko",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev": "eas build --profile development --platform all",
    "convex:dev": "npx convex dev",
    "seed:ingredients": "npx convex run router/ingredients/seedCatalog:_internal",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:app": "vitest run --project app",
    "test:convex": "vitest run --project convex",
    "test:scripts": "vitest run --project scripts",
    "test:watch": "vitest",
    "check:exports": "node scripts/c1-export-contract.mjs",
    "check:routers": "node scripts/c2-router-size.mjs",
    "check:queries": "node scripts/c3-query-rules.mjs",
    "check:schema": "node scripts/c4-schema-invariants.mjs",
    "check:authtests": "node scripts/c5-auth-tests.mjs",
    "check:docs": "node scripts/c6-doc-integrity.mjs",
    "check:codegen": "node scripts/c7-generated-api.mjs",
    "check:i18n": "node scripts/c8-i18n-parity.mjs",
    "check:cycles": "node scripts/c9-import-cycles.mjs",
    "check:tests": "node scripts/c10-test-reachability.mjs",
    "check": "pnpm check:exports && pnpm check:routers && pnpm check:queries && pnpm check:schema && pnpm check:authtests && pnpm check:docs && pnpm check:codegen && pnpm check:i18n && pnpm check:cycles && pnpm check:tests",
    "verify": "pnpm typecheck && pnpm lint && pnpm check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.94",
    "@expo/ui": "~57.0.9",
    "@shopify/flash-list": "2.0.2",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.121",
    "expo": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.11",
    "expo-secure-store": "^57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-video": "~57.0.2",
    "fastest-levenshtein": "^1.0.16",
    "i18next": "^26.3.6",
    "jotai": "^2.20.2",
    "lucide": "^1.28.0",
    "lucide-react-native": "^1.28.0",
    "morphicons": "^1.4.0",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.55",
    "eas-cli": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
