{
  "name": "cuisko",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "convex:dev": "npx convex dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:exports": "node scripts/c1-export-contract.mjs",
    "check:routers": "node scripts/c2-router-size.mjs",
    "check:queries": "node scripts/c3-query-rules.mjs",
    "check:schema": "node scripts/c4-schema-invariants.mjs",
    "check:authtests": "node scripts/c5-auth-tests.mjs",
    "check:docs": "node scripts/c6-doc-integrity.mjs",
    "check:codegen": "node scripts/c7-generated-api.mjs",
    "check": "pnpm check:exports && pnpm check:routers && pnpm check:queries && pnpm check:schema && pnpm check:authtests && pnpm check:docs && pnpm check:codegen",
    "verify": "pnpm typecheck && pnpm lint && pnpm check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.94",
    "@expo/ui": "~57.0.9",
    "@shopify/flash-list": "2.0.2",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.121",
    "expo": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.11",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.6",
    "jotai": "^2.20.2",
    "lucide": "^1.28.0",
    "lucide-react-native": "^1.28.0",
    "morphicons": "^1.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.55",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
