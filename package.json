    "expo-image-picker": "~57.0.11",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.11",
    "expo-secure-store": "^57.0.1",
    "expo-share-intent": "8.0.1",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.22",
    "fastest-levenshtein": "^1.0.16",
    "i18next": "^26.3.6",
    "jotai": "^2.20.2",
    "lucide": "^1.28.0",
    "lucide-react-native": "^1.28.0",
    "morphicons": "^1.7.1",
    "moti": "^0.30.0",
    "posthog-react-native": "^4.81.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "recipe-scrapers": "^3.0.0",
    "replicate": "^1.4.0",
    "runpod-sdk": "^1.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.55",
    "dotenv": "^17.4.2",
    "eas-cli": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}