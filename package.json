{
  "name": "cuisko",
  "version": "0.7.4",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "convex:dev": "npx convex dev",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev": "pnpm release && eas build --profile development --platform all",
    "seed:ingredients": "npx convex run router/ingredients/seedCatalog:_internal",
    "seed:catalog": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/recipes/import-catalog.ts",
    "catalog:export": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/recipes/export-catalog.ts",
    "catalog:restore": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/recipes/restore-catalog.ts",
    "catalog:verify": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/recipes/verify-catalog.ts",
    "ingredients:export": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/ingredients/export-ingredients.ts",
    "ingredients:restore": "tsx --env-file=.env.local --env-file=.env.catalog scripts/database/ingredients/restore-ingredients.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project app --project convex --project scripts",
    "test:app": "vitest run --project app",
    "test:convex": "vitest run --project convex",
    "test:scripts": "vitest run --project scripts",
    "test:manual": "vitest run --project manual --reporter=default --reporter.summary=false",
    "test:watch": "vitest --project app --project convex --project scripts",
    "check:exports": "node scripts/checks/c1-export-contract.mjs",
    "check:routers": "node scripts/checks/c2-router-size.mjs",
    "check:queries": "node scripts/checks/c3-query-rules.mjs",
    "check:schema": "node scripts/checks/c4-schema-invariants.mjs",
    "check:authtests": "node scripts/checks/c5-auth-tests.mjs",
    "check:docs": "node scripts/checks/c6-doc-integrity.mjs",
    "check:codegen": "node scripts/checks/c7-generated-api.mjs",
    "check:i18n": "node scripts/checks/c8-i18n-parity.mjs",
    "check:cycles": "node scripts/checks/c9-import-cycles.mjs",
    "check:tests": "node scripts/checks/c10-test-reachability.mjs",
    "check:search": "node scripts/checks/c11-derived-search-fields.mjs",
    "check:vocabulary": "node scripts/checks/c12-vocabulary-coverage.mjs",
    "check:threads": "node scripts/checks/c13-thread-access.mjs",
    "check:households": "node scripts/checks/c14-household-atoms.mjs",
    "check:recipes": "node scripts/checks/c15-live-recipe-reads.mjs",
    "check:ratelimits": "node scripts/checks/c16-rate-limits.mjs",
    "check:traces": "node scripts/checks/c17-traces.mjs",
    "check:events": "node scripts/checks/c18-event-senders.mjs",
    "check": "pnpm check:exports && pnpm check:routers && pnpm check:queries && pnpm check:schema && pnpm check:authtests && pnpm check:docs && pnpm check:codegen && pnpm check:i18n && pnpm check:cycles && pnpm check:tests && pnpm check:search && pnpm check:vocabulary && pnpm check:threads && pnpm check:households && pnpm check:recipes && pnpm check:ratelimits && pnpm check:traces && pnpm check:events",
    "release": "node scripts/release/bump-version.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1120.0",
