{
  "expo": {
    "name": "Cuisko",
    "slug": "cuisko",
    "version": "0.7.5",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "cuisko",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.cuisko.app",
      "associatedDomains": ["applinks:cuisko.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to turn what you say into text, so you can ask about a recipe or an ingredient out loud.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone so you can talk to the assistant instead of typing."
      }
    },
    "android": {
      "package": "com.cuisko.app",
      "userInterfaceStyle": "light",
      "backgroundColor": "#FFFCFA",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "cuisko.app", "pathPrefix": "/r/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/icons/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-video",
      "expo-localization",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#FAF2ED",
          "dark": {
            "backgroundColor": "#FAF2ED"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#FF6B0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera so you can scan the food in your fridge and cupboards, photograph a recipe, and point at a product to ask about it."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone so you can talk to the assistant instead of typing.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to turn what you say into text, so you can ask about a recipe or an ingredient out loud.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) access to your photo library so you can import photos of your groceries, your fridge or a recipe you want to keep.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera so you can scan the food in your fridge and cupboards, photograph a recipe, and point at a product to ask about it."
        }
      ],
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20511c07-a23a-4beb-8c57-8cfe85c746e8"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/20511c07-a23a-4beb-8c57-8cfe85c746e8"
    }
  }
}
