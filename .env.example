# ── Client (Expo) ────────────────────────────────────────────────────────────
# Copy to `.env.local`. Every key here is validated by `env.ts` and throws at boot.
# Only EXPO_PUBLIC_* keys reach the app bundle — never put a secret here.

EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# PostHog, for product analytics. The project token (`phc_...`) is public by design: it can only
# send events. Both are on the project's settings page; the host is https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ── Backend (Convex) ─────────────────────────────────────────────────────────
# These are NOT read from this file. Set them on the deployment:
#   npx convex env set SERVER_PRIVATE_KEY "$(openssl rand -hex 32)"
# Validated by `convex/env.ts`, which throws at boot if any is missing.
#
#   CONVEX_SITE_URL      set automatically by Convex — nothing to do
#   SERVER_PRIVATE_KEY   32+ chars. Authenticates `server` procedures.
#   OPENROUTER_API_KEY   the LLM key every agent tool calls through
#   POSTHOG_PROJECT_TOKEN  the app's `phc_...` token; what each paid call cost is sent there
#   POSTHOG_HOST           https://eu.i.posthog.com

# ── Local only ──────────────────────────────────────────────────────
# `pnpm test:manual` runs the model bake-offs outside Convex, so it is the one thing that reads the
# OpenRouter key from this file rather than from the deployment. Leave it blank unless you are
# running one — `npx convex env get OPENROUTER_API_KEY` prints the value to paste.

OPENROUTER_API_KEY=

# The transcrypt password for the agent memory in .claude/memory/ (encrypted on GitHub). Every
# `pnpm install` runs the memory setup, which reads it once to decrypt this clone. Keep a copy in
# a password manager: losing it loses the memory.
MEMORY_KEY=

# The GitHub App `sellest-agent`, which every Claude session pushes, comments and opens PRs as
# (docs/external/github.md). The App ID is on the App's settings page. The private key is the .pem
# GitHub gives once, base64-encoded on one line:
#   base64 -w0 sellest-agent.private-key.pem          (Git Bash)
# Read from the main checkout's file in a worktree; the token it buys is cached in .tmp/github/.
SELLEST_AGENT_APP_ID=
SELLEST_AGENT_PRIVATE_KEY=
