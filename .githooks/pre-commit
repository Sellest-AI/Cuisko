#!/bin/sh
#
# The fast checks, on every commit: the branch name, then the memory lock (a commit staging the
# agent memory outside `pnpm memory:update` is refused). The commit memory:update makes also runs
# the memory check (C20).
#
# A plain commit does not run `pnpm verify` here. An agent runs it once, in Step 1 of the
# `committing` skill, and CI `verify` is the required check into `dev` and `main` (ADR 0022).
# Running it here too made every agent commit verify twice.
#
# A merge commit still runs the whole `pnpm verify`: through pre-merge-commit on a clean merge,
# and here when a conflicted merge is committed. Its tree is the one no branch commit verified.
#
# Installed by the `prepare` script (`git config core.hooksPath .githooks`), which pnpm runs on
# install — so a fresh clone is protected after `pnpm install`, with no dependency to add.
#
# Genuinely need to bypass it?  git commit --no-verify
# Do that only when you already know what is broken and why it must land anyway.

set -e

# ── Branch naming ────────────────────────────────────────────────────────────────────────
# Same vocabulary as the commit types, plus `hotfix/` — which exists here and NOT as a commit
# type, because urgency is a property of the process, not of the change — and `sync/`, the branch
# that brings `main` back into `dev` through a PR (`sync/main-<YYYY-MM-DD>`, ADR 0022): its merge
# of `origin/dev` runs this hook through pre-merge-commit.
#
# Skipped when HEAD is detached (rebase, bisect, `git commit` during a merge), where the branch
# name is not the committer's to choose.
branch=$(git symbolic-ref --short -q HEAD || echo "")

# `main` and `dev` are the two long-lived branches: nothing is committed on them directly, but
# merging into them runs this hook (through pre-merge-commit), and their names are fixed.
if [ -n "$branch" ] && [ "$branch" != "main" ] && [ "$branch" != "dev" ]; then
  if ! echo "$branch" | grep -Eq '^(feat|fix|hotfix|sync|refactor|perf|docs|test|chore|ci)/[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo "✖ Commit refused: branch name \"$branch\" does not follow the convention." >&2
    echo "" >&2
    echo "  Format:  <type>/<kebab-case-summary>" >&2
    echo "  Types:   feat fix hotfix sync refactor perf docs test chore ci" >&2
    echo "  Example: git branch -m feat/recipe-scaling" >&2
    exit 1
  fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "✖ pnpm not found on PATH — cannot run this commit's checks." >&2
  echo "  Install pnpm, or bypass deliberately with: git commit --no-verify" >&2
  exit 1
fi

# ── Memory lock ──────────────────────────────────────────────────────────────────────────
# memories/ and usage/ under .claude/memory are written by `pnpm memory:update` (and usage/ by
# the monthly fold Action) only; this refuses any other commit staging them. Merges and conflicted reverts pass. Before
# verify, so a refused commit fails in a second, not after the tests. A refusal stops the hook
# here (set -e). It prints `memory-only` for a MEMORY_UPDATE=1 commit staging only the memory.
lock_decision=$(node "$(git rev-parse --show-toplevel)/scripts/memory/pre-commit.mjs")

# ── Is this a merge commit? ──────────────────────────────────────────────────────────────
# pre-merge-commit sets GIT_HOOK_NAME on a clean merge, which has no MERGE_HEAD yet. A conflicted
# merge is finished by `git commit`, which runs this hook alone, with MERGE_HEAD in place. Read
# before the unset below: in a worktree, MERGE_HEAD lives in that worktree's git folder.
is_merge=""
if [ "${GIT_HOOK_NAME:-}" = "pre-merge-commit" ] || [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  is_merge=1
fi

# ── Git's own variables stop here ────────────────────────────────────────────────────────
# Git hands a hook GIT_DIR and GIT_INDEX_FILE, and in a worktree GIT_DIR names that worktree's
# git folder. The tests below run git in throwaway repos: with GIT_DIR inherited, their `git init`
# reinitialises this repo instead, as a bare one, and every checkout of it stops working. Nothing
# after the lock reads the index, and git finds this repo from the working tree without them.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

# ── A memory:update commit ───────────────────────────────────────────────────────────────
# A commit staging only .claude/memory/ changes no code, test or doc: C20 is the one check that
# reads the memory (the tests build their own repos, the other checks scan code and docs/).
if [ "$lock_decision" = "memory-only" ]; then
  echo "→ pre-commit: memory commit, pnpm check:memory"
  if ! pnpm check:memory; then
    echo "" >&2
    echo "✖ Commit refused: the memory check failed." >&2
    echo "  Fix the memory files it names, then run pnpm memory:update again to finish the commit." >&2
    exit 1
  fi
  echo "✓ pre-commit: clean"
  exit 0
fi

# ── A merge commit ───────────────────────────────────────────────────────────────────────
# Only a merge commit runs the whole verify here (see the header). A plain commit stops above.
if [ -n "$is_merge" ]; then
  echo "→ pre-commit: merge commit, pnpm verify"
  if ! pnpm verify; then
    echo "" >&2
    echo "✖ Commit refused: pnpm verify failed on the merged tree." >&2
    echo "  Fix the findings above and commit again." >&2
    exit 1
  fi
fi

echo "✓ pre-commit: clean"
