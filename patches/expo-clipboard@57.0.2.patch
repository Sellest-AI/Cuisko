+/**
+ * Whether the clipboard holds a web link, alone or inside text, without reading it, so without
+ * raising the system's paste alert.
+ *
+ * @platform ios
+ */
+export async function hasWebLinkAsync() {
+    if (!ExpoClipboard.hasWebLinkAsync) {
+        throw new UnavailabilityError('Clipboard', 'hasWebLinkAsync');
+    }
+    return await ExpoClipboard.hasWebLinkAsync();
+}
